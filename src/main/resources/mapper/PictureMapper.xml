    <sql id="Base_Column_List">
        id,
    url,thumbnailUrl,name,introduction,category,tags,
    picSize,picWidth,picHeight,picScale,picFormat,
    userId,picColor,createTime,editTime,updateTime,isDelete,
    originalKey,compressedKey,thumbnailKey,storageBucket
