  <diagram id="stage3-selection" name="02 选片事务与并发">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="第三阶段 · 选片事务与并发控制" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#1E2A3A;" parent="1" vertex="1">
          <mxGeometry x="45" y="25" width="1510" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="selected=true/false 是目标状态；项目行锁保护 selectionLimit 与 version" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#566579;" parent="1" vertex="1">
          <mxGeometry x="47" y="76" width="1510" height="27" as="geometry" />
        </mxCell>
        <mxCell id="band0" value="" style="rounded=1;arcSize=8;html=1;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=1;opacity=55;" parent="1" vertex="1">
          <mxGeometry x="45" y="115" width="1510" height="470" as="geometry" />
        </mxCell>
        <mxCell id="bandlabel0" value="01  单次选片：同一 MySQL 事务" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="65" y="127" width="1470" height="28" as="geometry" />
        </mxCell>
        <mxCell id="band1" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFF3DF;strokeColor=#D59D3B;strokeWidth=1;opacity=55;" parent="1" vertex="1">
          <mxGeometry x="45" y="615" width="1510" height="295" as="geometry" />
        </mxCell>
        <mxCell id="bandlabel1" value="02  两位客户争夺最后一个名额" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="65" y="627" width="1470" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;PUT selection&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;itemId · selected&lt;br/&gt;expectedVersion&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF3DF;strokeColor=#D59D3B;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="85" y="180" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;会话定位项目&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;SELECT project FOR UPDATE&lt;br/&gt;同项目请求排队&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="385" y="180" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;检查状态与版本&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;SELECTING&lt;br/&gt;expectedVersion = 当前版本&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="685" y="180" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;检查 item 与额度&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;item 属于本项目&lt;br/&gt;新选中时 count &lt; limit&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="985" y="180" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;写入并返回结果&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;更新 item.selected 与 version+1&lt;br/&gt;返回已选数、余额、新版本&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F1EBFF;strokeColor=#8B6BC9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1285" y="180" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;状态 / 版本错误&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;拒绝旧请求&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FDE9E9;strokeColor=#D66D6D;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="685" y="360" width="250" height="90" as="geometry" />
