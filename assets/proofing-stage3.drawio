  <diagram id="stage3-share" name="01 分享与客户访问">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="第三阶段 · 分享链接与客户预览" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=30;fontStyle=1;fontColor=#1E2A3A;" parent="1" vertex="1">
          <mxGeometry x="45" y="25" width="1510" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="员工创建分享 → 客户换会话 → 按项目授权预览" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#566579;" parent="1" vertex="1">
          <mxGeometry x="47" y="76" width="1510" height="27" as="geometry" />
        </mxCell>
        <mxCell id="band0" value="" style="rounded=1;arcSize=8;html=1;fillColor=#EAF2FF;strokeColor=#5B8BD9;strokeWidth=1;opacity=55;" parent="1" vertex="1">
          <mxGeometry x="45" y="115" width="1510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="bandlabel0" value="01  员工创建 / 轮换" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="65" y="127" width="1470" height="28" as="geometry" />
        </mxCell>
        <mxCell id="band1" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFF3DF;strokeColor=#D59D3B;strokeWidth=1;opacity=55;" parent="1" vertex="1">
          <mxGeometry x="45" y="325" width="1510" height="215" as="geometry" />
        </mxCell>
        <mxCell id="bandlabel1" value="02  客户打开链接并换会话" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="65" y="337" width="1470" height="28" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="" style="rounded=1;arcSize=8;html=1;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=1;opacity=55;" parent="1" vertex="1">
          <mxGeometry x="45" y="570" width="1510" height="305" as="geometry" />
        </mxCell>
        <mxCell id="bandlabel2" value="03  客户读取项目与预览图" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="65" y="582" width="1470" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;项目鉴权&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;项目反查 spaceId&lt;br/&gt;proofing:manage + 状态&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#5B8BD9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="95" y="165" width="295" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;生成 shareToken&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;SecureRandom · 32 字节&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#5B8BD9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="465" y="165" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Redis 保存分享摘要&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;share:projectId = SHA-256(token)&lt;br/&gt;固定 TTL 7 天&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F1EBFF;strokeColor=#8B6BC9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="800" y="165" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;返回分享链接&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;publicId#token=...&lt;br/&gt;明文只返回一次&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#5B8BD9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1175" y="165" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;客户打开链接&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;前端读取 fragment 中的 token&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF3DF;strokeColor=#D59D3B;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="95" y="390" width="295" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;POST /public/session&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;提交 publicId + shareToken&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF3DF;strokeColor=#D59D3B;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="465" y="390" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;校验分享&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;项目状态 + 当前 Redis 摘要&lt;br/&gt;失败则拒绝&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="800" y="390" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;创建 sessionToken&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;Key = SHA-256(sessionToken)&lt;br/&gt;Value = projectId:shareHash&lt;br/&gt;TTL ≤ 30 分钟&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F1EBFF;strokeColor=#8B6BC9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1175" y="390" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;携带客户会话&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;X-Proofing-Session 请求头&lt;br/&gt;前端已清除地址栏令牌&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF3DF;strokeColor=#D59D3B;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="95" y="655" width="255" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;每次请求重新鉴权&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;会话摘要 + 当前分享摘要&lt;br/&gt;数据库项目状态&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="655" width="255" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;GET project&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;返回标题、状态、上限、版本&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="710" y="605" width="255" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;GET items / 单张续签&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;只查本项目可见 item&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#E6F5ED;strokeColor=#47A477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="710" y="755" width="255" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;资产白名单&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;本项目 + READY PREVIEW&lt;br/&gt;仍被可见 item 引用&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F1EBFF;strokeColor=#8B6BC9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1015" y="755" width="255" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;COS 签名&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#526174&quot;&gt;当前页 / 单张&lt;br/&gt;最多 10 分钟&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F1EBFF;strokeColor=#8B6BC9;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17243A;spacing=8;shadow=1;" parent="1" vertex="1">
